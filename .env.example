# Copy to .env.local (web) or your pipeline's local env file.
# Never commit real credentials. This file stays placeholder-only.

# Database (Postgres + pgvector, e.g. Neon free tier or local Docker)
DATABASE_URL=

# Authentication (Auth.js with Google sign-in)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM providers (free tiers; configure only what you use)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional local model endpoint for development
OLLAMA_BASE_URL=http://localhost:11434

# Optional market data (free tiers)
FINNHUB_API_KEY=
